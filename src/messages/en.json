  "staticPages": {
    "terms": {
      "title": "Terms & Conditions",
      "content": "<h2>Terms & Conditions</h2><p>By accessing and using this website, you accept and agree to be bound by the terms and provision of this agreement.</p><h3>1. Use of Site</h3><p>You may use this site for lawful purposes only. You agree not to use this site for any illegal or unauthorized purpose.</p><h3>2. Products & Pricing</h3><p>We reserve the right to modify prices and products at any time without prior notice. All prices are in Moroccan Dirham (MAD).</p><h3>3. Orders</h3><p>We reserve the right to refuse or cancel any order at our discretion. If your order is cancelled, you will receive a full refund.</p><h3>4. Contact</h3><p>For any questions regarding these terms, please contact us.</p>"
    },
    "privacy": {
      "title": "Privacy Policy",
      "content": "<h2>Privacy Policy</h2><p>Your privacy is important to us. This policy explains how we collect, use, and protect your personal information.</p><h3>Information We Collect</h3><p>We collect information you provide when creating an account, placing an order, or contacting us.</p><h3>How We Use Your Information</h3><p>We use your information to process orders, improve our services, and communicate with you.</p><h3>Data Protection</h3><p>We implement security measures to protect your personal data.</p>"
    },
    "faq": {
      "title": "Frequently Asked Questions",
      "content": "<h2>FAQ</h2><h3>How do I place an order?</h3><p>Browse our products, add items to your cart, and proceed to checkout.</p><h3>What payment methods do you accept?</h3><p>We accept credit cards via Stripe, PayPal, and WhatsApp ordering.</p><h3>How long does delivery take?</h3><p>Delivery typically takes 3-5 business days within Morocco.</p><h3>Can I return an item?</h3><p>Yes, we offer a 30-day return policy for most products.</p>"
    },
    "shipping": {
      "title": "Shipping Information",
      "content": "<h2>Shipping Information</h2><p>We deliver across Morocco and internationally.</p><h3>Domestic Shipping</h3><p>Free shipping on orders over the minimum threshold. Standard delivery: 3-5 business days.</p><h3>International Shipping</h3><p>International delivery times vary by destination.</p><h3>Order Tracking</h3><p>Once your order ships, you'll receive a tracking number via email.</p>"
    },
    "returns": {
      "title": "Returns & Exchanges",
      "content": "<h2>Returns & Exchanges</h2><p>We want you to be completely satisfied with your purchase.</p><h3>Return Policy</h3><p>You may return most products within 30 days of delivery for a full refund.</p><h3>How to Return</h3><p>Contact our support team to initiate a return. We'll guide you through the process.</p><h3>Refunds</h3><p>Refunds are processed within 7-10 business days after we receive your return.</p>"
    }
  },
